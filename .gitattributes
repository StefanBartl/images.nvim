# LF everywhere, including when checked out on Windows.
#
# Not just cosmetic: the module-map generator embeds source text into
# docs/map/module_map.json and index.html. Without this setting a Windows
# runner checks the sources out with CRLF, the map is generated differently
# from that than from the LF version, and `gen_map.lua --check` reports it as
# stale even though nothing actually changed.
* text=auto eol=lf

# Leave binary files untouched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
